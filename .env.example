# Backend Port
PORT=10000

# Mercado Pago Token
# Cómo obtenerlo:
# 1. Crea una cuenta en https://www.mercadopago.com
# 2. Ve a https://www.mercadopago.com/developers/panel
# 3. Copia tu "Access Token" de producción o desarrollo
# 4. Pegalo aquí sin comillas
MERCADOPAGO_TOKEN=APP_USR-REEMPLAZA_POR_TU_TOKEN

# Frontend URL (para CORS)
# Por defecto: http://localhost:10000 (local) o tu URL de Railway/Render
FRONTEND_URL=http://localhost:10000
BACKEND_URL=http://localhost:10000

# Token de administrador para panel admin (opcional)
# Cambia este valor por uno seguro antes de producción.
ADMIN_TOKEN=admin123
